[user]
	name = Daniel Yaren
	email = yarendaniel@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAID4Og7zhITlL7G4H4DO2YrjKNU7Jz5O3FZzQCMjomXN6
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[url "git@github.com:"]
	insteadOf = https://github.com/
